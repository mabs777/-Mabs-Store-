# ==========================================
# Mabs Store Production Configuration
# ==========================================

# 1. Admin Authentication Credentials
# Optional custom admin password override. Defaults to "admin" or set your custom password.
ADMIN_PASSWORD="admin"

# Secret key used for cryptographic HMAC-SHA256 token signatures.
ADMIN_SECRET_KEY=""

# 2. Persistent Hosted Database (Vercel KV / Upstash Redis / Remote REST)
# When deploying to Vercel or cloud environments, connect your persistent storage:
KV_REST_API_URL=""
KV_REST_API_TOKEN=""

# Upstash Redis REST credentials (alternative to Vercel KV):
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Generic Storage Endpoint (optional):
STORAGE_API_URL=""
STORAGE_API_KEY=""

# 3. Platform Environment (Auto-injected in production)
APP_URL=""
